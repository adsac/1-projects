      "transliterationPattern": "[GREETING]",
      "fushaNote": "Most Levantine greetings are MSA-shared (salām, ahlan), but day/night formulas (ṣabāḥ il-khēr / masā il-khēr) and responses (ṣabāḥ in-nūr) are colloquial conventions.",
      "forms": [
        { "key": "hi", "label": "hi / hello", "arabic": "مرحبا", "transliteration": "marḥaba", "english": "hello" },
        { "key": "hi.reply", "label": "hello (reply)", "arabic": "مرحبتين", "transliteration": "marḥabtēn", "english": "hello (lit. two hellos — warmer reply)" },
        { "key": "salam", "label": "peace upon you", "arabic": "السلام عليكم", "transliteration": "as-salāmu ʿalaykum", "english": "peace be upon you (formal/Muslim)" },
        { "key": "salam.reply", "label": "and peace upon you (reply)", "arabic": "وعليكم السلام", "transliteration": "wa-ʿalaykumu s-salām", "english": "and upon you peace" },
        { "key": "morning", "label": "good morning", "arabic": "صباح الخير", "transliteration": "ṣabāḥ il-khēr", "english": "good morning" },
        { "key": "morning.reply", "label": "good morning (reply)", "arabic": "صباح النور", "transliteration": "ṣabāḥ in-nūr", "english": "morning of light (reply)" },
        { "key": "evening", "label": "good evening", "arabic": "مسا الخير", "transliteration": "masā il-khēr", "english": "good evening" },
        { "key": "evening.reply", "label": "good evening (reply)", "arabic": "مسا النور", "transliteration": "masā in-nūr", "english": "evening of light (reply)" },
        { "key": "ahlan", "label": "welcome / hi", "arabic": "أهلاً وسهلاً", "transliteration": "ahlan wa-sahlan", "english": "welcome / hi" },
        { "key": "ahlan.reply", "label": "welcome (reply)", "arabic": "أهلين", "transliteration": "ahlēn", "english": "welcome (warm reply)" },
        { "key": "bye", "label": "goodbye", "arabic": "مع السلامة", "transliteration": "maʿ is-salāme", "english": "goodbye (lit. with safety)" },
        { "key": "bye.reply", "label": "go in peace (reply)", "arabic": "الله يسلّمك", "transliteration": "Allāh ysallmak", "english": "may God keep you safe" },
        { "key": "yalla", "label": "let's go / bye-ish", "arabic": "يلا باي", "transliteration": "yalla bāy", "english": "alright, bye" },
        { "key": "see-you", "label": "see you later", "arabic": "بشوفك", "transliteration": "bashūfak", "english": "I'll see you (m)" },
        { "key": "see-you.f", "label": "see you later (to f)", "arabic": "بشوفِك", "transliteration": "bashūfik", "english": "I'll see you (f)" },
        { "key": "thanks", "label": "thank you", "arabic": "شكراً", "transliteration": "shukran", "english": "thank you" },
        { "key": "thanks.reply", "label": "you're welcome", "arabic": "العفو", "transliteration": "il-ʿafu", "english": "you're welcome" }
      ],
      "tags": ["rescue", "drivers", "shops", "kids", "family", "work"],
      "status": "draft"
    },
