    {
      "id": "mumkin",
      "name": "Can I / could you... (mumkin)",
      "pattern": "Can [SUBJECT] [VERB]?",
      "arabicPattern": "ممكن [VERB]؟",
      "transliterationPattern": "mumkin [VERB]?",
      "fushaNote": "ممكن is shared with MSA (literally 'possible'). In spoken use it's a soft modal — 'can I...?', 'could you...?'. Polite and very common.",
      "forms": [
        { "key": "1sg", "label": "could I... (lit. is it possible I...)", "arabic": "ممكن", "transliteration": "mumkin", "english": "may I / can I" },
        { "key": "neg", "label": "not possible", "arabic": "مش ممكن", "transliteration": "mish mumkin", "english": "not possible / no way" },
        { "key": "law-samaḥt.m", "label": "if you'd allow (m, polite)", "arabic": "لو سمحت", "transliteration": "law samaḥt", "english": "if you please (to m)" },
        { "key": "law-samaḥt.f", "label": "if you'd allow (f, polite)", "arabic": "لو سمحتي", "transliteration": "law samaḥti", "english": "if you please (to f)" },
        { "key": "min-faḍlak.m", "label": "please (m)", "arabic": "من فضلك", "transliteration": "min faḍlak", "english": "please (to m)" },
        { "key": "min-faḍlik.f", "label": "please (f)", "arabic": "من فضلِك", "transliteration": "min faḍlik", "english": "please (to f)" }
      ],
      "slots": [
        {
          "name": "VERB",
          "options": [
            { "arabic": "أحكي معك", "transliteration": "aḥki maʿak", "english": "I speak with you (m)" },
            { "arabic": "أسأل سؤال", "transliteration": "asʾal suʾāl", "english": "I ask a question" },
            { "arabic": "تساعدني", "transliteration": "tsāʿidni", "english": "you help me" },
            { "arabic": "تعيد", "transliteration": "tʿīd", "english": "you repeat" },
            { "arabic": "تحكي شوي شوي", "transliteration": "tiḥki shwayy shwayy", "english": "you speak slowly" },
            { "arabic": "ادفع بالكرت", "transliteration": "adfaʿ bil-kart", "english": "I pay by card" },
