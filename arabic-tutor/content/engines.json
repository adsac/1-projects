        { "key": "imp.eat.m", "label": "eat! (m)", "arabic": "كُل", "transliteration": "kul", "english": "eat! (to m)" },
        { "key": "imp.wait.m", "label": "wait! (m)", "arabic": "استنّى", "transliteration": "istanna", "english": "wait! (to m)" },
