{
  "name": "MSA Reader",
  "short_name": "MSA Reader",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e1822",
  "theme_color": "#0e1822",
  "orientation": "portrait",
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "share-title",
      "text": "share-text",
      "url": "share-url"
    }
  },
  "icons": [
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ]
}
